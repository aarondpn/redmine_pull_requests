<%# Stored secrets are not rendered into the page: a blank field keeps the value (see SettingsControllerPatch) %>
<% stored = settings[name].present? %>
<%= password_field_tag "settings[#{name}]", nil, id: "settings_#{name}", size: 50, autocomplete: 'new-password',
                       placeholder: (stored ? '••••••••' : nil) %>
<% if stored %>
  <label class="inline">
    <%= check_box_tag 'clear_pull_request_settings[]', name, false, id: "clear_settings_#{name}" %>
    <%= l(:label_pull_request_remove_secret) %><span class="hidden-for-sighted">: <%= label %></span>
  </label>
  <em class="info"><%= l(:text_pull_request_secret_stored) %></em>
<% end %>
